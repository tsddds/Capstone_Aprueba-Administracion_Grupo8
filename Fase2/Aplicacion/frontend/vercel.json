{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/base-fase2-equipo": false,
      "equipo-a/**": false,
      "equipo-b/**": false,
      "equipo-c/**": false
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aprueba-admin-api-pruebas.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
