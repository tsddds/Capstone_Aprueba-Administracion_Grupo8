{
  "name": "aprueba-admin-backend",
  "version": "1.0.0",
  "description": "API REST de la consola de administración de Aprueba (Express + Firestore)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed/seed.js",
    "emulator": "firebase emulators:start --only firestore",
    "dev:isolated": "node --watch dev/start.mjs",
    "seed:dev": "node dev/seed.mjs",
    "test": "node --test test/unit/*.test.mjs",
    "test:integration": "node dev/run-tests.mjs smoke",
    "test:contract": "node dev/run-tests.mjs contract"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.6.0",
    "jsonwebtoken": "^9.0.2"
  }
}
